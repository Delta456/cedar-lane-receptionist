# Copy to .env and fill in. Never commit .env or the key file.

# Path to the Google service account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=./key.json

# Calendar ID from "Settings for this calendar -> Integrate calendar".
# Share the calendar with the service account ("Make changes to events").
CALENDAR_ID=

# The part of the Sheet URL between /d/ and /edit.
# Share the Sheet with the service account as an Editor.
SHEET_ID=

# API key from https://build.nvidia.com (open the model page, then "Get API Key").
NVIDIA_API_KEY=

# Optional. Any OpenAI-compatible endpoint and model; defaults to NVIDIA's
# hosted https://integrate.api.nvidia.com/v1 and nvidia/nemotron-3.5-bolt-e4b.
LLM_BASE_URL=
LLM_MODEL=

# Optional. Defaults to 3000.
PORT=

# Optional. debug, info (the default), warn, error or silent.
LOG_LEVEL=

# Phase 2 (voice on Vapi). Leave VAPI_SECRET empty to keep the voice routes off.
# A long random string, at least 16 characters, e.g. from: openssl rand -hex 24
# It goes in the URLs Vapi calls, so only Vapi can reach the agent's tools.
VAPI_SECRET=
# Private API key from the Vapi dashboard. Only used by `npm run vapi:setup`.
VAPI_API_KEY=
# The public HTTPS address of this server, e.g. a cloudflared tunnel URL.
PUBLIC_URL=
# Set after the first `npm run vapi:setup`, so later runs update the same assistant.
VAPI_ASSISTANT_ID=
